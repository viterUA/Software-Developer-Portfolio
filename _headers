# HTTP security headers — read by Netlify and Cloudflare Pages (the file itself
# is never served to visitors). GitHub Pages ignores it: there, the CSP <meta>
# tag in index.html still protects the main page, but the extra headers below
# (clickjacking protection, HSTS, nosniff, Permissions-Policy) need a host that
# supports custom headers.
#
# Keep the main-page CSP in sync with the <meta http-equiv="Content-Security-Policy">
# in index.html.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests; frame-ancestors 'none'

/index.html
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests; frame-ancestors 'none'

# The original coursework demos use inline scripts, Google Fonts, mailto: forms
# and (B&B) Facebook/Twitter widgets. They also run inside a sandboxed iframe,
# so this policy only needs to keep them to those sources and to being framed
# by this site.
/assets/demos/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://platform.twitter.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://platform.twitter.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.facebook.com https://web.facebook.com https://platform.twitter.com https://syndication.twitter.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'
